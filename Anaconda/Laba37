# Налаштування випадкових чисел для відтворюваності
np.random.seed(42)
tf.random.set_seed(42)

# Константи
IMG_SIZE = 48
NUM_CLASSES = 7
EMOTION_LABELS = ['Angry', 'Disgust', 'Fear', 'Happy', 'Sad', 'Surprise', 'Neutral']
INITIAL_SAMPLE_SIZE = 1000
SAMPLES_PER_ITERATION = 200
NUM_ITERATIONS = 8

# ==================== ФУНКЦІЇ ДЛЯ ОБРОБКИ ДАНИХ ====================

def load_fer2013_data(file_path=None):
    """
    Завантаження даних FER2013.
    Якщо файл не знайдено, генеруємо синтетичні дані для демонстрації.
    """
    if file_path:
        try:
            df = pd.read_csv(file_path)
            pixels = df['pixels'].apply(lambda x: np.array(x.split(), dtype='float32'))
            X = np.array([p.reshape(IMG_SIZE, IMG_SIZE, 1) for p in pixels])
            y = df['emotion'].values
            return X / 255.0, y
        except FileNotFoundError:
            print(f"Файл {file_path} не знайдено. Генеруємо синтетичні дані...")
    
    # Генерація синтетичних даних для демонстрації
    print("Генерація синтетичних даних для демонстрації роботи алгоритму...")
    n_samples = 8000
    X = np.random.rand(n_samples, IMG_SIZE, IMG_SIZE, 1).astype('float32')
    
    # Додаємо патерни для кожного класу емоцій
    for i in range(n_samples):
        emotion = i % NUM_CLASSES
        # Додаємо унікальні патерни для кожної емоції
        if emotion == 0:  # Angry
            X[i, 10:20, 10:20, 0] += 0.5
        elif emotion == 1:  # Disgust
            X[i, 20:30, 20:30, 0] += 0.5
        elif emotion == 2:  # Fear
            X[i, 30:40, 10:20, 0] += 0.5
        elif emotion == 3:  # Happy
            X[i, 10:20, 30:40, 0] += 0.5
        elif emotion == 4:  # Sad
            X[i, 20:30, 10:20, 0] += 0.5
        elif emotion == 5:  # Surprise
            X[i, 10:20, 20:30, 0] += 0.5
        else:  # Neutral
            X[i, 30:40, 30:40, 0] += 0.5
    
    X = np.clip(X, 0, 1)
    y = np.array([i % NUM_CLASSES for i in range(n_samples)])
    
    # Перемішуємо дані
    indices = np.random.permutation(n_samples)
    return X[indices], y[indices]


def preprocess_image(image):
    """
    Попередня обробка зображення:
    - Зміна розміру до 48x48
    - Нормалізація
    - Перетворення в градації сірого якщо потрібно
    """
    if len(image.shape) == 3 and image.shape[2] == 3:
        image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    
    if image.shape[:2] != (IMG_SIZE, IMG_SIZE):
        image = cv2.resize(image, (IMG_SIZE, IMG_SIZE))
    
    # Нормалізація
    image = image.astype('float32') / 255.0
    
    # Додаємо розмірність каналу
    if len(image.shape) == 2:
        image = np.expand_dims(image, axis=-1)
    
    return image


def detect_and_extract_face(image, face_cascade=None):
    """
    Виявлення обличчя на зображенні та його витягнення.
    """
    if face_cascade is None:
        # Завантаження каскаду Haar для виявлення обличчя
        cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
        face_cascade = cv2.CascadeClassifier(cascade_path)
    
    # Перетворення в градації сірого
    if len(image.shape) == 3:
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    else:
        gray = image
    
    # Виявлення облич
    faces = face_cascade.detectMultiScale(gray, 1.1, 4)
    
    if len(faces) == 0:
        return None
    
    # Беремо найбільше обличчя
    x, y, w, h = max(faces, key=lambda f: f[2] * f[3])
    face = gray[y:y+h, x:x+w]
    
    return preprocess_image(face)


def augment_image(image):
    """
    Аугментація зображення для збільшення різноманітності даних.
    """
    augmented = image.copy()
    
    # Випадкове горизонтальне відображення
    if np.random.random() > 0.5:
        augmented = np.fliplr(augmented)
    
    # Випадкове обертання (-10 до 10 градусів)
    angle = np.random.uniform(-10, 10)
    center = (IMG_SIZE // 2, IMG_SIZE // 2)
    M = cv2.getRotationMatrix2D(center, angle, 1.0)
    augmented = cv2.warpAffine(augmented.squeeze(), M, (IMG_SIZE, IMG_SIZE))
    augmented = np.expand_dims(augmented, axis=-1)
    
    # Випадкова зміна яскравості
    brightness = np.random.uniform(0.8, 1.2)
    augmented = np.clip(augmented * brightness, 0, 1)
    
    return augmented


# ==================== МОДЕЛЬ CNN ====================

def create_emotion_cnn(input_shape=(IMG_SIZE, IMG_SIZE, 1), num_classes=NUM_CLASSES):
    """
    Створення згорткової нейронної мережі для класифікації емоцій.
    """
    model = Sequential([
        # Перший згортковий блок
        Conv2D(32, (3, 3), activation='relu', padding='same', input_shape=input_shape),
        BatchNormalization(),
        Conv2D(32, (3, 3), activation='relu', padding='same'),
        BatchNormalization(),
        MaxPooling2D((2, 2)),
        Dropout(0.25),
        
        # Другий згортковий блок
        Conv2D(64, (3, 3), activation='relu', padding='same'),
        BatchNormalization(),
        Conv2D(64, (3, 3), activation='relu', padding='same'),
        BatchNormalization(),
        MaxPooling2D((2, 2)),
        Dropout(0.25),
        
        # Третій згортковий блок
        Conv2D(128, (3, 3), activation='relu', padding='same'),
        BatchNormalization(),
        Conv2D(128, (3, 3), activation='relu', padding='same'),
        BatchNormalization(),
        MaxPooling2D((2, 2)),
        Dropout(0.25),
        
        # Четвертий згортковий блок
        Conv2D(256, (3, 3), activation='relu', padding='same'),
        BatchNormalization(),
        MaxPooling2D((2, 2)),
        Dropout(0.25),
        
        # Повнозв'язний шар
        Flatten(),
        Dense(512, activation='relu'),
        BatchNormalization(),
        Dropout(0.5),
        Dense(256, activation='relu'),
        BatchNormalization(),
        Dropout(0.5),
        Dense(num_classes, activation='softmax')
    ])
    
    model.compile(
        optimizer=Adam(learning_rate=0.001),
        loss='categorical_crossentropy',
        metrics=['accuracy']
    )
    
    return model


# ==================== АКТИВНЕ НАВЧАННЯ ====================

def calculate_entropy(predictions):
    """
    Обчислення ентропії прогнозів для визначення невизначеності.
    """
    return entropy(predictions, axis=1)


def select_samples_by_entropy(model, X_pool, n_samples):
    """
    Вибір найбільш інформативних зразків на основі ентропії прогнозів.
    """
    predictions = model.predict(X_pool, verbose=0)
    uncertainties = calculate_entropy(predictions)
    selected_indices = np.argsort(uncertainties)[-n_samples:]
    return selected_indices


def select_random_samples(X_pool, n_samples):
    """
    Випадковий вибір зразків (для порівняння).
    """
    indices = np.random.permutation(len(X_pool))[:n_samples]
    return indices


class ActiveLearner:
    """
    Клас для реалізації активного навчання.
    """
    
    def __init__(self, X_train, y_train, X_test, y_test, 
                 initial_sample_size=INITIAL_SAMPLE_SIZE,
                 samples_per_iteration=SAMPLES_PER_ITERATION):
        
        self.X_test = X_test
        self.y_test = y_test
        self.initial_sample_size = initial_sample_size
        self.samples_per_iteration = samples_per_iteration
        
        # Розділення на початкову вибірку та пул
        indices = np.random.permutation(len(X_train))
        self.labeled_indices = indices[:initial_sample_size]
        self.pool_indices = indices[initial_sample_size:]
        
        self.X_all = X_train
        self.y_all = y_train
        
        self.history = {
            'iteration': [],
            'train_size': [],
            'accuracy': [],
            'per_class_accuracy': [],
            'per_class_precision': [],
            'per_class_recall': []
        }
        
        self.model = None
    
    def get_labeled_data(self):
        """Отримання поточних позначених даних."""
        return self.X_all[self.labeled_indices], self.y_all[self.labeled_indices]
    
    def get_pool_data(self):
        """Отримання даних з пулу."""
        return self.X_all[self.pool_indices], self.y_all[self.pool_indices]
    
    def train_model(self, epochs=20, batch_size=32, verbose=0):
        """Навчання моделі на поточних позначених даних."""
        X_labeled, y_labeled = self.get_labeled_data()
        y_labeled_cat = to_categorical(y_labeled, NUM_CLASSES)
        
        # Розділення на тренувальні та валідаційні дані
        n_samples = len(X_labeled)
        n_val = max(int(n_samples * 0.1), 1)
        indices = np.random.permutation(n_samples)
        val_indices = indices[:n_val]
        train_indices = indices[n_val:]
        
        X_train_subset = X_labeled[train_indices]
        y_train_subset = y_labeled_cat[train_indices]
        X_val_subset = X_labeled[val_indices]
        y_val_subset = y_labeled_cat[val_indices]
        
        # Створення нової моделі
        self.model = create_emotion_cnn()
        
        # Callbacks
        early_stop = EarlyStopping(monitor='val_loss', patience=5, restore_best_weights=True)
        reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, min_lr=1e-6)
        
        # Аугментація даних
        datagen = ImageDataGenerator(
            rotation_range=10,
            width_shift_range=0.1,
            height_shift_range=0.1,
            horizontal_flip=True
        )
        
        # Навчання з аугментацією
        datagen.fit(X_train_subset)
        
        self.model.fit(
            datagen.flow(X_train_subset, y_train_subset, batch_size=batch_size),
            epochs=epochs,
            validation_data=(X_val_subset, y_val_subset),
            callbacks=[early_stop, reduce_lr],
            verbose=verbose
        )
    
    def evaluate(self):
        """Оцінка моделі на тестовому наборі."""
        y_pred = np.argmax(self.model.predict(self.X_test, verbose=0), axis=1)
        
        # Загальна точність
        accuracy = accuracy_score(self.y_test, y_pred)
        
        # Точність по класах
        per_class_acc = []
        per_class_prec = []
        per_class_rec = []
        
        for i in range(NUM_CLASSES):
            mask = self.y_test == i
            if np.sum(mask) > 0:
                class_acc = np.mean(y_pred[mask] == i)
                per_class_acc.append(class_acc)
            else:
                per_class_acc.append(0.0)
            
            # Precision
            pred_mask = y_pred == i
            if np.sum(pred_mask) > 0:
                precision = np.sum((y_pred == i) & (self.y_test == i)) / np.sum(pred_mask)
            else:
                precision = 0.0
            per_class_prec.append(precision)
            
            # Recall
            true_mask = self.y_test == i
            if np.sum(true_mask) > 0:
                recall = np.sum((y_pred == i) & (self.y_test == i)) / np.sum(true_mask)
            else:
                recall = 0.0
            per_class_rec.append(recall)
        
        return accuracy, per_class_acc, per_class_prec, per_class_rec
    
    def active_learning_iteration(self, strategy='entropy'):
        """
        Одна ітерація активного навчання.
        """
        if len(self.pool_indices) < self.samples_per_iteration:
            print("Недостатньо даних у пулі для наступної ітерації.")
            return False
        
        X_pool = self.X_all[self.pool_indices]
        
        if strategy == 'entropy':
            # Вибір за ентропією
            selected_pool_indices = select_samples_by_entropy(
                self.model, X_pool, self.samples_per_iteration
            )
        else:
            # Випадковий вибір
            selected_pool_indices = select_random_samples(X_pool, self.samples_per_iteration)
        
        # Оновлення індексів
        new_labeled = self.pool_indices[selected_pool_indices]
        self.labeled_indices = np.concatenate([self.labeled_indices, new_labeled])
        self.pool_indices = np.delete(self.pool_indices, selected_pool_indices)
        
        return True
    
    def run_active_learning(self, num_iterations=NUM_ITERATIONS, strategy='entropy'):
        """
        Запуск повного циклу активного навчання.
        """
        print(f"\n{'='*60}")
        print(f"Запуск активного навчання з стратегією: {strategy}")
        print(f"Початковий розмір вибірки: {self.initial_sample_size}")
        print(f"Зразків на ітерацію: {self.samples_per_iteration}")
        print(f"{'='*60}\n")
        
        # Початкове навчання
        print("Ітерація 0: Початкове навчання...")
        self.train_model()
        accuracy, per_class_acc, per_class_prec, per_class_rec = self.evaluate()
        
        self.history['iteration'].append(0)
        self.history['train_size'].append(len(self.labeled_indices))
        self.history['accuracy'].append(accuracy)
        self.history['per_class_accuracy'].append(per_class_acc)
        self.history['per_class_precision'].append(per_class_prec)
        self.history['per_class_recall'].append(per_class_rec)
        
        print(f"  Розмір тренувального набору: {len(self.labeled_indices)}")
        print(f"  Точність: {accuracy:.4f}")
        
        # Ітерації активного навчання
        for iteration in range(1, num_iterations + 1):
            print(f"\nІтерація {iteration}:")
            
            # Вибір нових зразків
            if not self.active_learning_iteration(strategy):
                break
            
            # Перенавчання моделі
            self.train_model()
            
            # Оцінка
            accuracy, per_class_acc, per_class_prec, per_class_rec = self.evaluate()
            
            self.history['iteration'].append(iteration)
            self.history['train_size'].append(len(self.labeled_indices))
            self.history['accuracy'].append(accuracy)
            self.history['per_class_accuracy'].append(per_class_acc)
            self.history['per_class_precision'].append(per_class_prec)
            self.history['per_class_recall'].append(per_class_rec)
            
            print(f"  Розмір тренувального набору: {len(self.labeled_indices)}")
            print(f"  Точність: {accuracy:.4f}")
            print(f"  Залишилось у пулі: {len(self.pool_indices)}")
        
        return self.history


